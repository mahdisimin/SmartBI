# Environment variables for the intelligentBI API server (main.go) and the
# Synops Kafka worker (external/synops/ver2). Read by pkg/config.go.
#
# Copy to .env and fill in real values. The Go binaries do NOT load .env files
# themselves — export the variables in your shell or service manager, e.g.:
#   bash:        set -a; source .env; set +a
#   PowerShell:  Get-Content .env | ? { $_ -match '^\s*[^#].*=' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$($k.Trim())" $v.Trim() }
#
# Never commit a real .env — it holds credentials.

# --- SQL Server (required) ---------------------------------------------------
# Login used to connect. Required, no default: the process refuses to start
# without it. Prefer a dedicated least-privilege login over "sa".
SMARTBI_DB_USER=smartbi_app
# Password for SMARTBI_DB_USER. Required, no default.
SMARTBI_DB_PASSWORD=change-me

# --- SQL Server (optional) ---------------------------------------------------
# Server host, optionally host:port. Default: "." (local default instance).
SMARTBI_DB_HOST=.
# Database name. Default: SMARTBI
SMARTBI_DB_NAME=SMARTBI

# --- HTTP API (optional) -----------------------------------------------------
# Comma-separated browser origins allowed by CORS. Must match exactly
# (scheme + host + port, no trailing slash).
# Default: http://localhost:5173 (the Vite dev server).
SMARTBI_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Login sessions (optional) -----------------------------------------------
# How long a login lasts (absolute, from login). Go duration: "12h", "30m", ...
# Default: 12h
SMARTBI_SESSION_TTL=12h
# Mark the session cookie Secure (sent over HTTPS only). MUST be true in any
# deployment served over HTTPS; false only for local http development.
# Default: false
SMARTBI_COOKIE_SECURE=false
